From fc155ce55c050d97cb143e04f8e0d868b9828940 Mon Sep 17 00:00:00 2001
From: dark <noreply@anthropic.com>
Date: Tue, 17 Nov 2026 18:13:44 +0530
Subject: [PATCH] 0.1.32-dev1: upload plugin zips as workflow artifacts

Release runs and PR builds keep the built zips on the run page
(30 days for releases, 7 for PRs).

Co-Authored-By: Claude Sonnet 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01BLwrTsXyX9gemYXpN8kHXS
---
 .github/workflows/release.yml      | 10 ++++++++++
 .github/workflows/validate.yml     |  8 ++++++++
 plugins/aegires-e2ee/js/about.ts   |  2 +-
 plugins/aegires-e2ee/manifest.json |  2 +-
 4 files changed, 20 insertions(+), 2 deletions(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index 8f77ff9..d9d0b44 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -65,6 +65,16 @@ jobs:
         env:
           GITHUB_TOKEN: ${{ secrets.READ_PACKAGES_TOKEN }} # For Gradle to download the API dependency.
 
+      # The zips are also kept on the run page, so anyone with repo access can grab one without a Release.
+      - name: Upload plugin zips
+        if: steps.plan.outputs.count != '0'
+        uses: actions/upload-artifact@v4
+        with:
+          name: plugin-zips-${{ github.ref_name }}-run${{ github.run_number }}
+          path: build/dist/*.zip
+          if-no-files-found: error
+          retention-days: 30
+
       - name: Publish to the pool
         if: steps.plan.outputs.count != '0'
         run: .github/scripts/publish-pool.sh
diff --git a/.github/workflows/validate.yml b/.github/workflows/validate.yml
index d322335..9a81746 100644
--- a/.github/workflows/validate.yml
+++ b/.github/workflows/validate.yml
@@ -53,6 +53,14 @@ jobs:
         env:
           GITHUB_TOKEN: ${{ secrets.READ_PACKAGES_TOKEN }} # For Gradle to download the API dependency. Read the warning above about this token.
 
+      - name: Upload plugin zips
+        uses: actions/upload-artifact@v4
+        with:
+          name: plugin-zips-pr${{ github.event.pull_request.number }}
+          path: build/dist/*.zip
+          if-no-files-found: error
+          retention-days: 7
+
       - name: Generate index from built artifacts
         run: |
           bun run generate-index \
diff --git a/plugins/aegires-e2ee/js/about.ts b/plugins/aegires-e2ee/js/about.ts
index 48e75ef..bf816f6 100644
--- a/plugins/aegires-e2ee/js/about.ts
+++ b/plugins/aegires-e2ee/js/about.ts
@@ -3,7 +3,7 @@
 declare const __DEV__: boolean;
 
 export const DEVELOPER = "Dark (system32crowdstrikewin11)";
-export const PLUGIN_VERSION = "0.1.31-dev3";
+export const PLUGIN_VERSION = "0.1.32-dev1";
 export const BUILD_NUMBER = "26110129"; // YYMM + (minor * 100 + patch); shown as text
 
 /**
diff --git a/plugins/aegires-e2ee/manifest.json b/plugins/aegires-e2ee/manifest.json
index f8246fb..8f357b1 100644
--- a/plugins/aegires-e2ee/manifest.json
+++ b/plugins/aegires-e2ee/manifest.json
@@ -4,7 +4,7 @@
 	"name": "Aegires E2EE",
 	"description": "End-to-end encryption for Discord on Valenced, compatible with the Aegires Android app. Encrypts and decrypts text messages, images, GIFs, videos and files (up to 1 GiB) with a shared password, using Aegires v2 (Argon2id, AES-GCM). Per-chat on/off with /e2ee, a lock icon next to decrypted messages, a native video player, and a native module (C Argon2id with Kotlin/Java fallback) that makes key derivation much faster than plain JS.",
 	"author": "Dark (https://github.com/system32crowdstrikewin11 \"GitHub\")",
-	"version": "0.1.31-dev3",
+	"version": "0.1.32-dev1",
 	"dependencies": {
 		"valenced.api": {
 			"version": ">=1 <2"
