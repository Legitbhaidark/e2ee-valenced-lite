-                if (!on || !Wallpaper.has(a)) {
-                    detach()
-                    return@runOnUiThread
-                }
-                watchLifecycle(a)
-                attach(a)
-                layer?.update(blur, alphaFor(strength))
-            } catch (_: Throwable) {
