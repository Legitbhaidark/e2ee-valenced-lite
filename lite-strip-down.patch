-const MAX_URL = 2000;
-
-const cache = new Map<string, LinkPreviewData | null>(); // url -> preview; null = looked up, nothing to show
-const waiting = new Map<string, Array<{ id: string; channel: string }>>(); // url -> messages waiting for it
